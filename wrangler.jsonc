// Cloudflare Workers deployment for the Champ HR ESS portal.
// Step-by-step setup: docs/cloudflare-deployment.md
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "champ-hr-ess",
	"main": "cloudflare/worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],

	// SvelteKit's client bundle and static files (written by `npm run build`).
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},

	// SSR + argon2 password checks need more than the free plan's 10 ms.
	"limits": { "cpu_ms": 30000 },

	"observability": { "enabled": true },

	// Postgres, through Hyperdrive. Replace the id with the one printed by
	// `npx wrangler hyperdrive create ...` (guide step 3). `localConnectionString`
	// is what `wrangler dev` uses instead.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "REPLACE_WITH_HYPERDRIVE_ID",
			"localConnectionString": "postgres://postgres:postgres@localhost:5432/champ_hr"
		}
	],

	// Uploaded files: policy documents, profile pictures, announcement and chat attachments.
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "champ-hr-files" }],

	"durable_objects": {
		"bindings": [
			{ "name": "CHAT_HUB", "class_name": "ChatHub" },
			{ "name": "KV_STORE", "class_name": "KvStore" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatHub", "KvStore"] }],

	// One tick a minute drives every background job (src/routes/api/internal/cron).
	"triggers": { "crons": ["* * * * *"] },

	// Non-secret settings. Secrets (JWT_SECRET, RESEND_API_KEY, CLERK_SECRET_KEY, ...)
	// are set with `npx wrangler secret put NAME` — see the guide.
	"vars": {
		"NODE_ENV": "production",
		"ORIGIN": "https://champ-hr.com",
		"PORTAL_URL": "https://champ-hr.com",
		"AUTH_PROVIDER": "legacy",
		"DEVICE_UTC_OFFSET": "+05:30",
		"PROHANCE_UTC_OFFSET": "+05:30",
		"PROHANCE_POLL_MINUTES": "0"
	}
}
