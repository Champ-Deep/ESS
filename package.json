{
	"name": "champ-hr-ess-portal",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx src/lib/server/db/seed.ts",
		"import-token:generate": "tsx src/lib/server/db/generate-import-token.ts",
		"diagnose:logins": "tsx src/lib/server/db/diagnose-logins.ts",
		"backfill:profiles": "tsx --import ./scripts/env-shim-register.mjs src/lib/server/db/backfill-profiles-from-sheet.ts",
		"clerk:migrate": "tsx --import ./scripts/env-shim-register.mjs scripts/migrate-to-clerk.ts",
		"build:node": "ADAPTER=node vite build",
		"cf:dev": "vite build && wrangler dev",
		"cf:deploy": "vite build && wrangler deploy",
		"cf:tail": "wrangler tail",
		"migrate:mongo": "tsx scripts/cloudflare/migrate-mongo-to-postgres.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261104.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/pg": "^8.20.0",
		"@types/web-push": "^3.6.4",
		"drizzle-kit": "^0.31.10",
		"mongodb": "^7.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10",
		"web-push": "^3.6.7",
		"wrangler": "^4.157.0"
	},
	"dependencies": {
		"@clerk/backend": "^3.25.0",
		"@lucide/svelte": "^1.27.0",
		"@noble/hashes": "^2.4.0",
		"drizzle-orm": "^0.45.2",
		"exceljs": "^4.4.0",
		"jose": "^6.2.4",
		"motion": "^13.4.0",
		"pg": "^8.22.0",
		"svelte-clerk": "^1.2.0"
	}
}
