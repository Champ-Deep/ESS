{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "champ-hr-ess",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"observability": { "enabled": true },

	// The portal AND its databases (Postgres, MongoDB, Redis) in one image.
	// Data survives restarts through R2 backups — see ess-box.sh.
	"containers": [
		{
			"class_name": "AppContainer",
			"image": "./Dockerfile",
			"image_build_context": "..",
			"instance_type": "standard-2",
			"max_instances": 1
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "APP", "class_name": "AppContainer" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppContainer"] }],

	// Lets the Worker restart the container when vars/secrets change (new version).
	"version_metadata": { "binding": "CF_VERSION_METADATA" },

	// Database backups. The container reaches this through the Worker (no API keys).
	"r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "champ-hr-ess-backups" }],

	// Keep-alive: restarts the container within 5 minutes if it ever stops.
	"triggers": { "crons": ["*/5 * * * *"] },

	// Plain settings. Everything secret (JWT_*, API keys) is added as a secret.
	// DATABASE_URL / MONGO_URL / REDIS_URL are set inside the container.
	"vars": {
		"NODE_ENV": "production",
		"ORIGIN": "https://champ-hr-ess.deep-ae0.workers.dev",
		"PORTAL_URL": "https://champ-hr-ess.deep-ae0.workers.dev",
		"BACKUP_INTERVAL_MINUTES": "5"
	}
}
