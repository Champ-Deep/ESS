{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "champ-hr-ess",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"observability": { "enabled": true },

	// The portal's own Docker image, built from the repo root.
	"containers": [
		{
			"class_name": "AppContainer",
			"image": "../Dockerfile",
			"image_build_context": "..",
			"instance_type": "standard-1",
			"max_instances": 1
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "APP", "class_name": "AppContainer" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppContainer"] }],

	// Keep-alive: restarts the container within 5 minutes if it ever stops.
	"triggers": { "crons": ["*/5 * * * *"] },

	// Plain settings. Everything secret (DATABASE_URL, MONGO_URL, REDIS_URL,
	// JWT_*, API keys) is added with `npx wrangler secret put` (see the guide).
	"vars": {
		"NODE_ENV": "production",
		"ORIGIN": "https://champ-hr.com",
		"PORTAL_URL": "https://champ-hr.com"
	}
}
